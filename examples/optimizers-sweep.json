    {"name": "sgd_momentum_lr0.10", "optimizer": "sgd_momentum", "learning_rate": 0.1, "momentum": 0.9, "epochs": 120},
    {"name": "sgd_momentum_lr0.20", "optimizer": "sgd_momentum", "learning_rate": 0.2, "momentum": 0.9, "epochs": 120},
    {"name": "adagrad_lr0.20", "optimizer": "adagrad", "learning_rate": 0.2, "epochs": 120},
    {"name": "adagrad_lr0.50", "optimizer": "adagrad", "learning_rate": 0.5, "epochs": 120},
    {"name": "adagrad_lr1.00", "optimizer": "adagrad", "learning_rate": 1.0, "epochs": 120},
    {"name": "rmsprop_lr0.02", "optimizer": "rmsprop", "learning_rate": 0.02, "decay": 0.9, "epochs": 120},
