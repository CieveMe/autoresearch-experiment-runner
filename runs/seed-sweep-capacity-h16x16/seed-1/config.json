{
  "task": "capacity expansion, hidden [16,16]: the same four claim families",
  "paper": {
    "title": "Cross-paper capacity expansion (Adam 2014, AdEMAMix 2024, Schedule-Free 2024)",
    "authors": "see docs/papers/",
    "year": 2026,
    "identifier": "internal-capacity-expansion"
