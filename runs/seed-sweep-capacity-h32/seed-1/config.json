{
  "task": "capacity check, hidden [32]: do the Adam / AdEMAMix / schedule-free conclusions survive a wider model?",
  "paper": {
    "title": "Cross-paper capacity check (Adam 2014, AdEMAMix 2024, Schedule-Free 2024)",
    "authors": "see docs/papers/",
    "year": 2026,
    "identifier": "internal-capacity-check"
  },
  "hypothesis": "Every earlier conclusion was measured on an 8-unit hidden layer. With 32 units and every arm retuned for that model, do the same directions hold - Adam mid-pack on speed, AdEMAMix without an advantage, schedule-free losing to a tuned cosine - and does the final loss beat the speed metric as a quality signal?",
  "metric": "test_loss",
  "target_loss": 0.147,
  "seed": 1,
  "trainer": "mlp",
  "hidden_sizes": [
    32
  ],
  "dataset": {
    "size": 800,
    "test_ratio": 0.25,
    "noise": 0.18
  },
  "baseline": {
    "name": "adamw_cosine",
    "optimizer": "adamw",
    "learning_rate": 0.3,
    "schedule": "cosine",
    "min_lr_factor": 0.1,
    "epochs": 200
  },
  "experiments": [
    {
      "name": "adamw_constant",
      "optimizer": "adamw",
      "learning_rate": 0.3,
      "epochs": 200
    },
    {
      "name": "adam",
      "optimizer": "adam",
      "learning_rate": 0.3,
      "epochs": 200
    },
    {
      "name": "adagrad",
      "optimizer": "adagrad",
      "learning_rate": 0.1,
      "epochs": 200
    },
    {
      "name": "ademamix",
      "optimizer": "ademamix",
      "alpha": 2.0,
      "beta3": 0.9999,
      "learning_rate": 0.3,
      "epochs": 200
    },
    {
      "name": "schedule_free_adamw",
      "optimizer": "schedule_free_adamw",
      "learning_rate": 0.3,
      "epochs": 200
    }
  ]
}
