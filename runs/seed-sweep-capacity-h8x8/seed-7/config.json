{
  "task": "capacity check, hidden [8,8]: does depth change the answers that width did not?",
  "paper": {
    "title": "Cross-paper capacity check (Adam 2014, AdEMAMix 2024, Schedule-Free 2024)",
    "authors": "see docs/papers/",
    "year": 2026,
    "identifier": "internal-capacity-check"
  },
  "hypothesis": "Same capacity question as the [32] run, for a two-layer [8,8] network: do the directions survive a change of depth as well as width, and does the train-loss ranking continue to diverge from the test-loss ranking as capacity grows?",
  "metric": "test_loss",
  "target_loss": 0.147,
  "seed": 7,
  "trainer": "mlp",
  "hidden_sizes": [
    8,
    8
  ],
  "dataset": {
    "size": 800,
    "test_ratio": 0.25,
    "noise": 0.18
  },
  "baseline": {
    "name": "adamw_cosine",
    "optimizer": "adamw",
    "learning_rate": 0.3,
    "schedule": "cosine",
    "min_lr_factor": 0.1,
    "epochs": 200
  },
  "experiments": [
    {
      "name": "adamw_constant",
      "optimizer": "adamw",
      "learning_rate": 0.3,
      "epochs": 200
    },
    {
      "name": "adam",
      "optimizer": "adam",
      "learning_rate": 0.3,
      "epochs": 200
    },
    {
      "name": "adagrad",
      "optimizer": "adagrad",
      "learning_rate": 0.1,
      "epochs": 200
    },
    {
      "name": "ademamix",
      "optimizer": "ademamix",
      "alpha": 2.0,
      "beta3": 0.9999,
      "learning_rate": 0.3,
      "epochs": 200
    },
    {
      "name": "schedule_free_adamw",
      "optimizer": "schedule_free_adamw",
      "learning_rate": 0.3,
      "epochs": 200
    }
  ]
}
